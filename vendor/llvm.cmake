# LLVM 23.1.3 libraries. The monorepo also contains Clang, LLD, and the
# other tools; this builds the LLVM libraries for the host target only.
# vendor.sh clones the monorepo into vendor/llvm-project. A checkout of this
# repository keeps it as the llvm-project submodule next to vendor/.
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/llvm-project/llvm/CMakeLists.txt")
    set(_thirdparty_llvm_src "${CMAKE_CURRENT_LIST_DIR}/llvm-project/llvm")
elseif(EXISTS "${CMAKE_CURRENT_LIST_DIR}/../llvm-project/llvm/CMakeLists.txt")
    set(_thirdparty_llvm_src "${CMAKE_CURRENT_LIST_DIR}/../llvm-project/llvm")
else()
    message(FATAL_ERROR "llvm-project was not found. Run vendor.sh, or check out the llvm-project submodule.")
endif()

set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
set(LLVM_ENABLE_PROJECTS "" CACHE STRING "" FORCE)
set(LLVM_ENABLE_RUNTIMES "" CACHE STRING "" FORCE)
set(LLVM_TARGETS_TO_BUILD "Native" CACHE STRING "" FORCE)
set(LLVM_APPEND_VC_REV OFF CACHE BOOL "" FORCE)
set(LLVM_BUILD_TOOLS OFF CACHE BOOL "" FORCE)
set(LLVM_INCLUDE_TOOLS OFF CACHE BOOL "" FORCE)
set(LLVM_BUILD_UTILS OFF CACHE BOOL "" FORCE)
set(LLVM_INCLUDE_UTILS OFF CACHE BOOL "" FORCE)
set(LLVM_BUILD_RUNTIME OFF CACHE BOOL "" FORCE)
set(LLVM_INCLUDE_RUNTIMES OFF CACHE BOOL "" FORCE)
set(LLVM_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
set(LLVM_INCLUDE_EXAMPLES OFF CACHE BOOL "" FORCE)
set(LLVM_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(LLVM_INCLUDE_TESTS OFF CACHE BOOL "" FORCE)
set(LLVM_BUILD_BENCHMARKS OFF CACHE BOOL "" FORCE)
set(LLVM_INCLUDE_BENCHMARKS OFF CACHE BOOL "" FORCE)
set(LLVM_BUILD_DOCS OFF CACHE BOOL "" FORCE)
set(LLVM_INCLUDE_DOCS OFF CACHE BOOL "" FORCE)
set(LLVM_ENABLE_BINDINGS OFF CACHE BOOL "" FORCE)
set(LLVM_ENABLE_OCAMLDOC OFF CACHE BOOL "" FORCE)
set(LLVM_ENABLE_TELEMETRY OFF CACHE BOOL "" FORCE)
set(LLVM_ENABLE_PLUGINS OFF CACHE BOOL "" FORCE)
set(LLVM_BUILD_LLVM_DYLIB OFF CACHE BOOL "" FORCE)
set(LLVM_BUILD_LLVM_C_DYLIB OFF CACHE BOOL "" FORCE)
set(LLVM_ENABLE_ZLIB "OFF" CACHE STRING "" FORCE)
set(LLVM_ENABLE_ZSTD "OFF" CACHE STRING "" FORCE)
set(LLVM_ENABLE_LIBXML2 "OFF" CACHE STRING "" FORCE)
set(LLVM_ENABLE_LIBEDIT OFF CACHE BOOL "" FORCE)
set(LLVM_ENABLE_LIBPFM OFF CACHE BOOL "" FORCE)
set(LLVM_ENABLE_CURL "OFF" CACHE STRING "" FORCE)
set(LLVM_ENABLE_HTTPLIB "OFF" CACHE STRING "" FORCE)
set(LLVM_ENABLE_Z3_SOLVER OFF CACHE BOOL "" FORCE)
set(LLVM_ENABLE_FFI OFF CACHE BOOL "" FORCE)
set(LLVM_ENABLE_IDE OFF CACHE BOOL "" FORCE)

add_subdirectory("${_thirdparty_llvm_src}" "${CMAKE_CURRENT_BINARY_DIR}/llvm")
